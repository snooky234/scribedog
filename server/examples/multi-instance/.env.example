# PERSON1 and PERSON2 are two ready-made instance slots, "anna" and "bob" by
# default. To rename a person, change their PERSON<N>_BASE_PATH and
# PERSON<N>_DATA_DIR below. BASE_PATH is the one place their URL-facing
# name lives, driving both docker-compose.yml and the Caddyfile without
# editing either; DATA_DIR only needs changing here too, to keep the data
# folder's name in step. Adding a third person means copying one
# PERSON<N> group here, one service block in docker-compose.yml and one
# handle block in the Caddyfile, all using the next number; see
# docs/multiuser.md. Starting with only one person works the same way,
# just leave PERSON2 out here (and its service/handle block).
#
# Copy to .env. Eight characters or more each, or that instance rejects it
# and keeps restarting (Caddy then answers with 502s for it until fixed). One
# init password per instance; each is used only until that instance has a
# password in its data folder, then it can be removed.
PERSON1_INIT_PASSWORD=
PERSON2_INIT_PASSWORD=

# Where each instance answers, e.g. https://<host>/anna/. Change this to
# rename a person; see the note above.
PERSON1_BASE_PATH=/anna
PERSON2_BASE_PATH=/bob

# The data folder for each instance, relative to this file. Only matters if
# you want it named differently than the default below, or if you are
# pointing this at a folder that already exists (see docs/multiuser.md,
# "Moving an existing single instance here").
PERSON1_DATA_DIR=anna-data
PERSON2_DATA_DIR=bob-data

# One Linux user per instance keeps the data folders apart on the host
# (see docs/multiuser.md, "Keeping the folders apart"): id -u / id -g of that user.
PERSON1_PUID=1000
PERSON1_PGID=1000
PERSON2_PUID=1001
PERSON2_PGID=1001

# Host name or IP the site answers on, and the certificate mode (see the
# single-instance .env.example).
SCRIBEDOG_SITE_ADDRESS=localhost
SCRIBEDOG_TLS=internal
SCRIBEDOG_HTTP_PORT=80
SCRIBEDOG_HTTPS_PORT=443

# Published image instead of a local build. Already set to the current
# version; leave it as is for the latest release, set an older tag on
# purpose, or empty it to build from the repository instead.
SCRIBEDOG_IMAGE=ghcr.io/snooky234/scribedog-server:0.17.0
