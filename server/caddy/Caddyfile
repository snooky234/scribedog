# Caddy in front of ScribeDog Server: TLS termination only, nothing else.
#
# The whole request path is passed through unchanged. ScribeDog knows its own
# SCRIBEDOG_BASE_PATH and answers under it (and 404s everywhere else), so the
# proxy never has to strip or rewrite a prefix. If you route several instances
# behind one host, use `handle` (keeps the path), never `handle_path` (strips it):
#
#   handle /anna* { reverse_proxy scribedog-anna:3000 }
#   handle /bob*  { reverse_proxy scribedog-bob:3000 }

{
	# A browser that opens the site by IP address sends no server name, and
	# with more than one site in this file (several instances, the test
	# stack's mock model) Caddy then has nothing to pick a certificate by and
	# drops the handshake. This names the site whose certificate answers such
	# a client; docker-compose.yml defaults it to the site address.
	default_sni {$SCRIBEDOG_DEFAULT_SNI:localhost}

	# The HTTP port is set up below rather than by Caddy's automatic redirect,
	# because it does more than redirect. Certificates for Let's Encrypt are
	# still requested over it as usual.
	auto_https disable_redirects
}

# The CA certificate of this installation (scripts/make-certs.mjs), so that
# trusting it is opening one URL on the device. With Let's Encrypt there is
# no such file and the URL answers 404, which is also how the app's settings
# know not to offer the download.
(ca_certificate) {
	handle /scribedog-ca.crt {
		root * /certs
		rewrite * /ca.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
}

{$SCRIBEDOG_SITE_ADDRESS:localhost} {
	# Empty SCRIBEDOG_TLS: the certificate made by scripts/make-certs.mjs
	# (docker-compose.yml fills in the two file paths). An e-mail address:
	# Caddy obtains a Let's Encrypt certificate for a public domain instead.
	tls {$SCRIBEDOG_TLS}

	encode zstd gzip

	import ca_certificate

	handle {
		reverse_proxy scribedog:3000
	}
}

# Plain HTTP: hands out the CA certificate (a device that does not trust it
# yet cannot download it over HTTPS without a warning), answers health checks,
# and sends everything else to HTTPS with a 307, which keeps the method and
# body of a request instead of turning it into a GET.
http:// {
	import ca_certificate

	# Under whatever SCRIBEDOG_BASE_PATH is, hence the leading wildcard.
	@health path */api/health
	handle @health {
		reverse_proxy scribedog:3000
	}

	handle {
		redir https://{host}:{$SCRIBEDOG_HTTPS_PORT:443}{uri} 307
	}
}
