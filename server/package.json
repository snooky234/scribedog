{
  "name": "scribedog-server",
  "private": true,
  "version": "0.17.0",
  "description": "ScribeDog Server Edition: the ScribeDog note editor as a self-hosted web app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.4.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
