{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://(10\\.[0-9]+\\.[0-9]+\\.[0-9]+):*/*" },
        { "url": "http://(172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]+\\.[0-9]+):*/*" },
        { "url": "http://(192\\.168\\.[0-9]+\\.[0-9]+):*/*" },
        { "url": "http://*.local:*/*" },
        { "url": "http://*.lan:*/*" },
        { "url": "http://*.home.arpa:*/*" },
        { "url": "http://*.internal:*/*" },
        { "url": "http://*.fritz.box:*/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.mistral.ai/*" }
      ]
    },
    "fs:read-dirs",
    "fs:read-files",
    "fs:scope-appconfig",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat"
  ]
}
